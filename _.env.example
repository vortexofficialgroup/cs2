# UE Dubai Room Portal — Environment Variables
# Copy to .env and fill in your values

# Admin panel login credentials
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me-to-a-long-random-password

# HMAC signing secret for session tokens (make it long and random)
ADMIN_SECRET=change-me-to-a-long-random-string-in-production

# Optional: Database (Supabase / Neon Postgres)
# DATABASE_URL=postgresql://user:password@host/dbname

# Optional: Supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-publishable-key
#
# SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# DeepSeek API key — required for the chatbot and AI Assistant tab
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Optional default model for the AI Assistant (defaults to DeepSeek Flash).
# Users may switch between DeepSeek Flash and DeepSeek Pro in the admin UI.
#DEEPSEEK_MODEL=deepseek-flash

# Required for shared admin changes when deployed on Vercel.
# Keep the service-role key server-side; never expose it with a VITE_ prefix.
